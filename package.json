{
  "name": "porta-control-plane",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "render:prep-git-auth": "git config --global url.\"https://${GITHUB_TOKEN}@github.com/\".insteadOf \"ssh://git@github.com/\" && git config --global url.\"https://${GITHUB_TOKEN}@github.com/\".insteadOf \"git@github.com:\"",
    "render:build": "npm run render:prep-git-auth && npm install && npm run build",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --pool=threads --poolOptions.threads.singleThread"
  },
  "dependencies": {
    "@porta/api-contracts": "github:PORTA-Tech/porta-api-contracts#cbd4c7e",
    "express": "^4.21.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.7",
    "@types/supertest": "^6.0.3",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "supertest": "^7.2.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
